{
  "name": "ai-leaming-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "把 ai-leaming 的外部 API 暴露成 MCP 工具（stdio），供 dsh 等 agent 客户端挂载",
  "type": "module",
  "bin": {
    "ai-leaming-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "doc-tasks": "node scripts/doc-tasks.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.11",
    "typescript": "5.6.3"
  }
}
