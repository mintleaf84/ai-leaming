# Server Configuration
# 运行环境: development | production
NODE_ENV=development

# Database
# SQLite 数据库文件名，Docker 部署时不需要修改，因为会挂载到 /app/data
DB_FILENAME=ai-learning.db

# Authentication
# 生成安全密钥: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# AI Service Configuration
# 支持兼容 OpenAI 接口的模型服务商 (DeepSeek, SiliconFlow, OpenAI 等)
# 在线申请: https://platform.openai.com/account/api-keys
AI_API_KEY=your_api_key_here
AI_API_URL=https://api.openai.com/v1

# Testing
# 仅在运行 E2E 测试时设置为 true
E2E_TEST=false

# 可选配置

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 备份加密密钥（可选，WebDAV 备份功能需要）
# BACKUP_ENCRYPTION_KEY=

# PaddleOCR 识别服务 Token（可选，OCR 功能需要）
# PADDLE_OCR_TOKEN=

# 公开的应用 URL（可选，用于 CORS 白名单）
# NEXT_PUBLIC_APP_URL=
