# Server Configuration
# 运行环境: development | production
NODE_ENV=development

# Database
# SQLite 数据库文件名，Docker 部署时不需要修改，因为会挂载到 /app/data
DB_FILENAME=ai-learning.db

# Authentication
# 生成安全密钥: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# AI Service Configuration
# 支持兼容 OpenAI 接口的模型服务商 (DeepSeek, SiliconFlow, OpenAI 等)
# 在线申请: https://platform.openai.com/account/api-keys
AI_API_KEY=your_api_key_here
AI_API_URL=https://api.openai.com/v1

# 粉笔账号同步（可选）
# 用于加密存库的粉笔密码与会话 cookie（AES-256-GCM）。
# 不配时自动用 HKDF-SHA256 从 JWT_SECRET 派生一个子密钥（info=fenbi-cred-v1）；
# 配了就必须是 32 字节 base64：openssl rand -base64 32
# 注意：轮换 JWT_SECRET 会让所有粉笔绑定失效，需要用户重新绑定。
FENBI_SECRET=

# Testing
# 仅在运行 E2E 测试时设置为 true
E2E_TEST=false

# 可选配置

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 备份加密密钥（WebDAV 备份密码用它加解密）
# 生产环境**必须**有值：留空时 start.sh 会自动生成并持久化到 data/.env.production，
# 因此用官方镜像时通常不用手填；手动部署 / 多实例共享数据库时必须显式指定同一个值，
# 否则换机器后已保存的 WebDAV 密码会解不开（页面会提示重新填写密码）。
# BACKUP_ENCRYPTION_KEY=

# PaddleOCR 识别服务 Token（可选，OCR 功能需要）
# PADDLE_OCR_TOKEN=

# 公开的应用 URL（可选，用于 CORS 白名单）
# NEXT_PUBLIC_APP_URL=
